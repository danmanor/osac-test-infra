evpn:
  enabled: true
  nmstate:
    install: true
    channel: stable
  configureClusterNetwork: true
  vtepCIDR: {{ ocp_evpn_vtep_cidr | to_json }}
  bgp:
    asn: {{ ocp_underlay_ocp_asn | int }}
    acceptPrefixes:
      - {{ ocp_evpn_netris_loopback_cidr | to_json }}
    waitForEstablished: true
    timeoutSeconds: 900
  nodes:
    - name: {{ _ocp_evpn_node_name | to_json }}
      vtepIP: {{ _ocp_evpn_vtep_node_ip | to_json }}
      uplinks:
        - interface: {{ ocp_underlay_guest_interface | to_json }}
          address: {{ (_ocp_evpn_ocp_ip ~ '/31') | to_json }}
          peerAddress: {{ _ocp_evpn_leaf_ip | to_json }}
          peerASN: {{ _ocp_evpn_leaf_asn | int }}
